{
  "name": "eml-shipping-tracker",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "start": "NODE_ENV=development electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.3.0"
  },
  "build": {
    "appId": "com.eml.shipping-tracker",
